// Prisma Schema - Catalog Service
// Database: cropfresh_catalog
// Purpose: Crop listings, inventory, pricing

generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

// Crop Model - Master list of crops
model Crop {
  id        Int       @id @default(autoincrement())
  name      String    @unique @db.VarChar(100)
  category  String    @db.VarChar(50)
  basePrice Decimal   @map("base_price") @db.Decimal(10, 2)
  unit      String    @db.VarChar(20) // kg, ton, etc.
  createdAt DateTime  @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt DateTime  @updatedAt @map("updated_at") @db.Timestamptz(6)
  deletedAt DateTime? @map("deleted_at") @db.Timestamptz(6)

  inventory Inventory[]
  listings  Listing[]

  @@map("crops")
}

// Inventory Model - Farmer's available produce
model Inventory {
  id          Int       @id @default(autoincrement())
  cropId      Int       @map("crop_id")
  farmerId    Int       @map("farmer_id") // Reference to Auth service User ID
  quantity    Decimal   @db.Decimal(10, 2)
  quality     String?   @db.VarChar(50) // Grade A, B, C
  harvestDate DateTime? @map("harvest_date") @db.Date
  createdAt   DateTime  @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt   DateTime  @updatedAt @map("updated_at") @db.Timestamptz(6)
  deletedAt   DateTime? @map("deleted_at") @db.Timestamptz(6)

  crop Crop @relation(fields: [cropId], references: [id])

  @@map("inventory")
}

// ============================================================================
// LISTING DOMAIN - Story 3.1: Voice/Manual/Photo Crop Listing
// ============================================================================

/// Listing status progression:
/// DRAFT -> PENDING_PHOTO -> PENDING_GRADING -> ACTIVE -> MATCHED -> COMPLETED
/// Alternative paths: CANCELLED, EXPIRED
enum ListingStatus {
  DRAFT // Initial creation (voice/manual input done)
  PENDING_PHOTO // Waiting for photo upload
  PENDING_GRADING // Photo uploaded, AI grading in progress
  ACTIVE // Graded and visible to buyers
  MATCHED // Buyer matched, pending pickup
  IN_TRANSIT // Produce picked up by hauler
  DELIVERED // Delivered to buyer
  COMPLETED // Payment settled
  CANCELLED // Farmer or system cancelled
  EXPIRED // No buyer match within timeframe
}

/// Entry mode determines listing creation flow
enum ListingEntryMode {
  MANUAL // Type to List - farmer types everything
  VOICE // Speak to List - voice-to-text with NLP extraction
  PHOTO // Photo-first - AI detects crop from image
}

/// Story 3.9: Cancellation reason for analytics (AC7)
enum CancellationReason {
  SOLD_ELSEWHERE // Farmer sold produce elsewhere
  QUALITY_CHANGED // Produce quality deteriorated
  CHANGED_MIND // Farmer changed their mind
  OTHER // Other reasons
}

/// Photo validation status for quality checks
enum PhotoValidationStatus {
  PENDING // Uploaded, not yet validated
  VALID // Passed quality checks
  INVALID // Failed quality checks
}

/// Farmer's crop listing for sale
model Listing {
  id       Int @id @default(autoincrement())
  farmerId Int @map("farmer_id")
  cropId   Int @map("crop_id")

  // Quantity
  quantityKg Decimal  @map("quantity_kg") @db.Decimal(10, 2)
  unit       String   @default("kg") @db.VarChar(20)
  displayQty Decimal? @map("display_qty") @db.Decimal(10, 2)

  // Quality assessment
  qualityGrade String?  @map("quality_grade") @db.VarChar(10) // A, B, C
  aiGrade      String?  @map("ai_grade") @db.VarChar(10) // AI-assessed
  aiConfidence Decimal? @map("ai_confidence") @db.Decimal(5, 4) // 0.0000-1.0000

  // Media
  photoUrl       String? @map("photo_url") @db.VarChar(500)
  photoThumbnail String? @map("photo_thumbnail") @db.VarChar(500)

  // Entry tracking (manual/voice/photo)
  entryMode     ListingEntryMode @default(MANUAL) @map("entry_mode")
  voiceText     String?          @map("voice_text") @db.Text // Raw STT output
  voiceLanguage String?          @map("voice_language") @db.VarChar(10) // kn, hi, en, ta, te

  // Pricing
  estimatedPrice Decimal? @map("estimated_price") @db.Decimal(12, 2)
  pricePerKg     Decimal? @map("price_per_kg") @db.Decimal(10, 2)

  // Status and dates
  status      ListingStatus @default(DRAFT)
  harvestDate DateTime?     @map("harvest_date") @db.Date
  expiresAt   DateTime?     @map("expires_at") @db.Timestamptz(6)
  matchedAt   DateTime?     @map("matched_at") @db.Timestamptz(6)
  completedAt DateTime?     @map("completed_at") @db.Timestamptz(6)

  // Story 3.9: Cancellation tracking (AC7-9)
  cancelledAt        DateTime?           @map("cancelled_at") @db.Timestamptz(6)
  cancellationReason CancellationReason? @map("cancellation_reason")

  // Audit
  createdAt DateTime  @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt DateTime  @updatedAt @map("updated_at") @db.Timestamptz(6)
  deletedAt DateTime? @map("deleted_at") @db.Timestamptz(6)

  // Relations
  crop   Crop           @relation(fields: [cropId], references: [id])
  photos ListingPhoto[]

  // Indexes for common queries
  @@index([farmerId])
  @@index([status])
  @@index([cropId])
  @@index([createdAt(sort: Desc)])
  @@map("listings")
}

// ============================================================================
// PHOTO DOMAIN - Story 3.2: Produce Photo Capture and Upload
// ============================================================================

/// Listing photo with metadata and validation status
model ListingPhoto {
  id        Int @id @default(autoincrement())
  listingId Int @map("listing_id")

  // Storage
  photoUrl         String  @map("photo_url") @db.VarChar(500)
  thumbnailUrl     String? @map("thumbnail_url") @db.VarChar(500)
  s3Key            String  @map("s3_key") @db.VarChar(500)
  originalFilename String? @map("original_filename") @db.VarChar(255)
  contentType      String  @default("image/jpeg") @map("content_type") @db.VarChar(50)

  // File info
  fileSizeBytes     Int? @map("file_size_bytes")
  originalSizeBytes Int? @map("original_size_bytes")
  width             Int?
  height            Int?

  // Location metadata (AC6)
  latitude    Decimal? @db.Decimal(10, 8)
  longitude   Decimal? @db.Decimal(11, 8)
  deviceModel String?  @map("device_model") @db.VarChar(100)

  // Quality validation (AC3, AC4)
  qualityScore      Decimal?              @map("quality_score") @db.Decimal(3, 2) // 0.00-1.00
  validationStatus  PhotoValidationStatus @default(PENDING) @map("validation_status")
  validationMessage String?               @map("validation_message") @db.Text

  // Flags
  isPrimary Boolean @default(false) @map("is_primary")

  // Audit
  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(6)

  // Relations
  listing Listing @relation(fields: [listingId], references: [id])

  @@index([listingId])
  @@map("listing_photos")
}

// ============================================================================
// EDUCATIONAL CONTENT DOMAIN - Story 3.11: Educational Content on Quality Best Practices
// ============================================================================

/// Content type for educational materials
enum ContentType {
  VIDEO // Video content (YouTube/Vimeo embedded)
  ARTICLE // Text article with markdown
  INFOGRAPHIC // Single image infographic
}

/// Content category for filtering
enum ContentCategory {
  HARVEST // Harvest timing and techniques
  STORAGE // Storage and handling practices
  PHOTOGRAPHY // Photo tips for AI grading
  HANDLING // Gentle handling to prevent damage
  PACKAGING // Proper packaging and crating
  GENERAL // General farming tips
}

/// Quality issue type for recommendation matching
enum QualityIssue {
  BRUISING // Produce bruising
  SIZE_INCONSISTENCY // Size variation in batch
  RIPENESS_ISSUES // Over/under ripe produce
  FRESHNESS_CONCERNS // Freshness degradation
  PACKAGING_PROBLEMS // Poor packaging detected
}

/// Educational content - videos, articles, infographics for farmers
model EducationalContent {
  id              String            @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  type            ContentType
  title           String            @db.VarChar(255)
  titleRegional   Json?             @map("title_regional") // {"kn": "ಶೀರ್ಷಿಕೆ", "hi": "शीर्षक"}
  description     String?           @db.Text
  thumbnailUrl    String            @map("thumbnail_url") @db.VarChar(500)
  contentUrl      String            @map("content_url") @db.Text // YouTube URL, S3 URL, or markdown content
  durationSeconds Int?              @map("duration_seconds") // For videos
  readTimeMinutes Int?              @map("read_time_minutes") // For articles
  language        String            @default("en") @db.VarChar(10)
  cropTypes       String[]          @map("crop_types") // ['TOMATO', 'ONION']
  categories      ContentCategory[]
  qualityIssues   QualityIssue[]    @map("quality_issues") // For recommendation matching
  isFeatured      Boolean           @default(false) @map("is_featured")
  isActive        Boolean           @default(true) @map("is_active")
  createdAt       DateTime          @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt       DateTime          @updatedAt @map("updated_at") @db.Timestamptz(6)

  // Relations
  views     ContentView[]
  bookmarks ContentBookmark[]

  @@index([type])
  @@index([isFeatured])
  @@index([isActive])
  @@index([createdAt(sort: Desc)])
  @@map("educational_content")
}

/// Content view tracking - tracks farmer's viewing history and progress
model ContentView {
  id              String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  contentId       String   @map("content_id") @db.Uuid
  farmerId        Int      @map("farmer_id")
  progressPercent Int      @default(0) @map("progress_percent") // 0-100
  isCompleted     Boolean  @default(false) @map("is_completed")
  viewedAt        DateTime @default(now()) @map("viewed_at") @db.Timestamptz(6)
  updatedAt       DateTime @updatedAt @map("updated_at") @db.Timestamptz(6)

  // Relations
  content EducationalContent @relation(fields: [contentId], references: [id], onDelete: Cascade)

  @@unique([contentId, farmerId])
  @@index([farmerId])
  @@index([viewedAt(sort: Desc)])
  @@map("content_views")
}

/// Content bookmark - farmer's saved/bookmarked content
model ContentBookmark {
  id           String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  contentId    String   @map("content_id") @db.Uuid
  farmerId     Int      @map("farmer_id")
  bookmarkedAt DateTime @default(now()) @map("bookmarked_at") @db.Timestamptz(6)

  // Relations
  content EducationalContent @relation(fields: [contentId], references: [id], onDelete: Cascade)

  @@unique([contentId, farmerId])
  @@index([farmerId])
  @@index([bookmarkedAt(sort: Desc)])
  @@map("content_bookmarks")
}
